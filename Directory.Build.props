<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

    <Authors>natyusha</Authors>
    <RepositoryUrl>https://github.com/natyusha/E2x2-Switch</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>

    <Title>E2x2 Switch</Title>
    <Version>1.1.2</Version>
    <Description>A lightweight Windows utility for controlling the TOPPING E2x2 Audio Interface via global keyboard shortcuts.</Description>

    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <!-- Generate C# identity constants to DRY properties across project and runtime reflection -->
  <Target Name="GenerateE2x2SwitchConstants" BeforeTargets="BeforeCompile;CoreCompile;CompileDesignTime">
    <PropertyGroup>
      <_GeneratedConstantsFile>$(IntermediateOutputPath)E2x2SwitchConstants.g.cs</_GeneratedConstantsFile>
      <_GeneratedConstantsCode>
        <![CDATA[// <auto-generated />
namespace E2x2Switch%3B

/// <summary>Centralized constants for application identity and metadata.</summary>
public static partial class E2x2SwitchConstants
{
    /// <summary>Display name of the application.</summary>
    public const string Name = "$(Title)"%3B

    /// <summary>Description of the application.</summary>
    public const string Description = "$(Description)"%3B

    /// <summary>Current version string.</summary>
    public const string Version = "$(Version)"%3B

    /// <summary>Repository URL for the project.</summary>
    public const string RepositoryUrl = "$(RepositoryUrl)"%3B
}
        ]]>
      </_GeneratedConstantsCode>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <WriteLinesToFile File="$(_GeneratedConstantsFile)" Lines="$(_GeneratedConstantsCode)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />

    <ItemGroup>
      <Compile Include="$(_GeneratedConstantsFile)" />
      <FileWrites Include="$(_GeneratedConstantsFile)" />
    </ItemGroup>
  </Target>
</Project>
